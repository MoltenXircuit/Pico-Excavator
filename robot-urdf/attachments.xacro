<?xml version="1.0" ?>
<robot name="pico-excavator" xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="claw">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="0.041"/>
    <inertia ixx="1.0" iyy="1.0" izz="1.0" iyz="0.0" ixy="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find pico-excavator)/robot-urdf/meshes/ExcavatorURDF_Arm-Dipper.dae" scale="1.0 1.0 1.0"/>
    </geometry>
    <!-- <material name="dk_green"/> -->
  </visual>
  <collision>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find pico-excavator)/meshes/ExcavatorURDF_Arm-Dipper.dae" scale="1.0 1.0 1.0"/>
    </geometry>
  </collision>
</link>

<link name="bucket">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="0.016"/>
    <inertia ixx="1.0" iyy="1.0" izz="1.0" iyz="0.0" ixy="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find pico-excavator)/robot-urdf/meshes/ExcavatorURDF_Arm-Dipper.dae" scale="1.0 1.0 1.0"/>
    </geometry>
    <!-- <material name="dk_green"/> -->
  </visual>
  <collision>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find pico-excavator)/meshes/ExcavatorURDF_Arm-Dipper.dae" scale="1.0 1.0 1.0"/>
    </geometry>
  </collision>
</link>
</robot>
