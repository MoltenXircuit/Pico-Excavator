<!-- //////track joints -->
<joint name="track_main_to_base_link" type="revolute">
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="track_base"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit effort="1000" velocity="2.0" lower="-6.28" upper="6.28" />
</joint>

<joint name="wheel_left_1_to_track_base" type="continuous">
  <origin xyz="-0.068204 -0.046753 -0.025528" rpy="0 0 0"/>
  <parent link="track_base"/>
  <child link="wheel_left_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="wheel_right_1_to_track_base" type="continuous">
  <origin xyz="-0.068204  0.047027 -0.025528" rpy="0 0 0"/>
  <parent link="track_base"/>
  <child link="wheel_right_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="wheel_left_2_to_track_base" type="continuous">
  <origin xyz="-0.022899 -0.046753 -0.025528" rpy="0 0 0"/>
  <parent link="track_base"/>
  <child link="wheel_left_2"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

