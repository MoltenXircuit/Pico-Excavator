<?xml version="1.0" ?>
<robot name="pico-excavator" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- <xacro:include filename="$(find pico-excavator)/robot-urdf/materials.xacro" /> -->
<!-- <xacro:include filename="$(find pico-excavator)/robot-urdf/excavator_URDF.gazebo" /> -->




<link name="track_base">
  <inertial>
    <origin xyz="0.0 0.0 -0.025" rpy="0 0 0"/>
    <mass value="0.120"/>
    <inertia ixx="1.8e-4" iyy="2.2e-4" izz="3.6e-4" iyz="0.0" ixy="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find pico-excavator)/robot-urdf/meshes/ExcavatorURDF_Track-Main.dae" scale="1.0 1.0 1.0"/>
    </geometry>
    <!-- <material name="dk_green"/> -->
  </visual>
  <collision>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find pico-excavator)/robot-urdf/meshes/ExcavatorURDF_Track-Main.stl" scale="1.0 1.0 1.0"/>
    </geometry>
  </collision>
</link>

